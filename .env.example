# Copy to .env on the VPS and fill in. docker-compose.prod.yml reads it.
# Dev (docker-compose.yml) uses baked-in insecure defaults — no .env needed.
#
# Generate the two secrets with:
#   make secrets

# --- Public identity ---------------------------------------------------------
# The only place the domain is written. Drives ALLOWED_HOSTS, CSRF origins,
# SITE_URL, the RSS feed and the sitemap.
DOMAIN=oddlyunspecific.com
SITE_NAME=oddlyunspecific
SITE_TAGLINE=Thoughts, mostly

# --- Django ------------------------------------------------------------------
# 50+ random chars. Rotating it logs everyone out — that is fine.
DJANGO_SECRET_KEY=change-me-run-make-secrets

# The admin lives here instead of /admin/ so scanners never find it.
# No leading/trailing slash. Make it boring but unguessable.
#
# DO NOT SHIP THE VALUE BELOW. It is committed to this repository, so using it
# publishes the one thing that keeps scanners off the admin. `make secrets`
# prints a fresh one, and the app refuses to start on this placeholder or on
# a bare "admin".
DJANGO_ADMIN_PATH=console-7f3a2b

# --- Journal encryption ------------------------------------------------------
# Fernet key(s), comma separated. The FIRST key encrypts new entries; every key
# listed can decrypt. That is how you rotate: prepend a new key, run
# `make prod-rotate-journal`, then drop the old one.
#
# LOSE THIS KEY AND THE PRIVATE ENTRIES ARE GONE FOREVER. Back it up somewhere
# that is not this server (password manager).
JOURNAL_ENCRYPTION_KEYS=change-me-run-make-secrets

# --- Database ----------------------------------------------------------------
DB_USER=oddly
DB_PASSWORD=change-me
DB_NAME=oddly

# --- Backups -----------------------------------------------------------------
# Passphrase for `make backup`. Set it.
#
# The dump is NOT harmless without it. Journal entries inside stay Fernet
# ciphertext, but the same file also carries the TOTP seeds (django-otp stores
# device keys in plaintext) and the Argon2 password hashes — so a leaked dump
# hands over the second factor, which is the whole point of having one.
#
# Leave it empty and `make backup` still runs, loudly, writing plaintext.
# Generate one with `make secrets`, and store it wherever
# JOURNAL_ENCRYPTION_KEYS lives — NOT on this server.
BACKUP_PASSPHRASE=change-me-run-make-secrets

# --- Proxy / real client IP --------------------------------------------------
# caddy = behind the shared VPS Caddy (the only production topology)
# none  = Django is reachable directly (local dev only)
#
# Wrong value here means brute-force lockouts hit the proxy instead of the
# attacker, so only change it when the topology actually changes. Any other
# value and the app refuses to start.
TRUSTED_PROXY=caddy

# --- Rate limiting -----------------------------------------------------------
# Per-IP caps on /write/, /private/ and the admin path. The public blog is not
# rate limited. Defaults shown; uncomment only to change them.
#
# Three budgets. A verified staff session gets the generous one, because the
# console is chatty by design: live preview is debounced at 400ms, so writing
# with a pause every second is ~60 requests a minute on its own.
#RATE_LIMIT_ENABLED=1

# Anonymous, or logged in without a second factor — i.e. a prober.
#RATE_LIMIT_REQUESTS=60
#RATE_LIMIT_WINDOW_SECONDS=60

# The login endpoints. Always applies: no verified session exists yet.
#RATE_LIMIT_LOGIN_REQUESTS=10
#RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# The author at the console. Generous, but not unlimited — this is what stops
# a runaway client, not a person.
#RATE_LIMIT_VERIFIED_REQUESTS=600
#RATE_LIMIT_VERIFIED_WINDOW_SECONDS=60

# --- Locale ------------------------------------------------------------------
TIME_ZONE=Europe/Rome
LANGUAGE_CODE=en-us
