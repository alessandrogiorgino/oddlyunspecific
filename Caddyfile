# Site block for the SHARED Caddy of the VPS (the detoxy / back_to_me one that
# owns :80/:443). Paste it into that project's Caddyfile next to the weddypal
# and paupernopaper blocks, then reload:
#
#   docker exec back_to_me_caddy caddy reload --config /etc/caddy/Caddyfile
#
# It proxies straight to this project's container, so `back_to_me_caddy` must be
# attached to the oddlyunspecific network first (`make link-caddy` does that).
# This project runs no Caddy of its own — same topology as WeddyPal.
#
# ONE EXTRA STEP, in the shared Caddy's own compose file: mount this project's
# media volume so Caddy can serve uploaded images without waking Django.
#
#     services:
#       caddy:
#         volumes:
#           - oddlyunspecific_media:/srv/oddlyunspecific/media:ro
#     volumes:
#       oddlyunspecific_media:
#         external: true
#
# If you skip it nothing breaks — the `file` matcher below finds no file and
# the request falls through to Django exactly as it used to.

# www -> apex, one canonical host. Keeps ALLOWED_HOSTS and the sitemap honest.
www.oddlyunspecific.com {
	redir https://oddlyunspecific.com{uri} permanent
}

oddlyunspecific.com {
	# Refuse oversized bodies before they reach Django. 12MB covers an image
	# upload from the writer console; nothing else here needs a big body.
	request_body {
		max_size 12MB
	}

	encode zstd gzip

	# Uploaded images, straight off the volume.
	#
	# Serving these through Django means one of gunicorn's six threads
	# (3 workers x 2) is pinned for the whole transfer. Six people on slow
	# connections loading a post full of photos is enough to stall the site,
	# and it needs no malice at all. Caddy streams them without a thread.
	#
	# The @onvolume guard keeps the mount optional: no file, no match, and the
	# request drops through to the reverse_proxy below, where Django's
	# serve_media still answers.
	handle /media/* {
		root * /srv/oddlyunspecific
		@onvolume file
		header @onvolume {
			# Filenames are a SHA-256 of the re-encoded bytes, so a given URL
			# never changes meaning and can be cached forever.
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
			Cross-Origin-Resource-Policy same-origin
			-Server
		}
		file_server @onvolume

		reverse_proxy oddlyunspecific-web-1:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy oddlyunspecific-web-1:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}

			# Caddy appends the real client IP to any X-Forwarded-For the
			# client sent, so Django reads the LAST entry, not the first. See
			# config/middleware.py RealClientIPMiddleware.
		}
	}

	# Django sets the full security header set per-path (config/middleware.py).
	# Caddy only removes its own fingerprint.
	header {
		-Server
	}

	log {
		output file /var/log/caddy/oddlyunspecific.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# --- On rate limiting ---------------------------------------------------------
#
# Deliberately not done here. Caddy's `rate_limit` is a third-party plugin, not
# part of the standard build, and adding it means recompiling the ONE Caddy that
# fronts every site on this VPS — a much bigger blast radius than the problem.
#
# The limiter lives in Django instead (config/middleware.py RateLimitMiddleware,
# tuned by RATE_LIMIT_* in settings.py). It only guards /write/, /private/ and
# the admin path; the public blog is left alone on purpose so readers, feed
# fetchers and crawlers can pull the whole site. It also tells a verified
# console session apart from a prober and gives it a far larger budget — which
# is the other reason it is not in Caddy: Caddy cannot see the session.
#
# If the shared Caddy ever does get the plugin, the cheapest win is a per-IP
# limit on /write/login/ — it would turn away floods one hop earlier, before a
# Python process is involved at all.
